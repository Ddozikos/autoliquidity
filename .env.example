GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# For local testing only, matching the supplied example. Prefer true when certificates are configured.
GIGACHAT_VERIFY_SSL_CERTS=false
DATABASE_URL=sqlite:///./data/app.db
MAX_CONCURRENT_LLM_CALLS=5

# Authorized search API endpoints. Each GET endpoint accepts vin, make, model and year,
# and returns JSON: {"offers":[{"price":1234567,"url":"https://..."}],"demand":82}
# demand is optional and must be a provider-issued numeric score from 0 to 100.
# Configure only the providers for which you have API access.
AVITO_PRICE_API_URL=
AVITO_PRICE_API_KEY=
AUTORU_PRICE_API_URL=
AUTORU_PRICE_API_KEY=
DROM_PRICE_API_URL=
DROM_PRICE_API_KEY=
SBERAUTO_PRICE_API_URL=
SBERAUTO_PRICE_API_KEY=

# ApiAd search for live Avito and Drom ads (requires a key from apiad.ru).
# With both sources enabled this makes up to 2 provider requests per car.
# Check provider terms/tariffs before enabling. Only make/model/year are sent;
# VIN and debtor information are never included in this search.
APIAD_API_KEY=
APIAD_API_BASE_URL=https://apiad.ru
APIAD_ENABLED=false

VIN_API_URL=
VIN_API_KEY=
